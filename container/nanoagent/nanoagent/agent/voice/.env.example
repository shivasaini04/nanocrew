# ─────────────────────────────────────────────────────────────────────────────
# Voice service — OPERATOR configuration.
#
# Read this before adding anything here: this file is for values that belong to
# the DEPLOYMENT, not to a user. Anything that identifies a tenant — their phone
# number, their email identity, their company, their agent's name — lives in the
# database per tenant, NOT here.
#
# Two things used to be in this file that must never come back:
#   * EXOTEL_* credentials as a fallback. A tenant with no telephony of their own
#     silently dialled on the operator's account: the prospect saw the operator's
#     ExoPhone and every DND/TRAI complaint landed on the operator.
#   * EMAIL_SERVER_* as a fallback. A tenant's demo invite was sent FROM the
#     operator's address, so replies went to the wrong company.
# Both now resolve per tenant with no fallback. Unconfigured means "does not
# send", never "sends as someone else".
# ─────────────────────────────────────────────────────────────────────────────

# ── AI capacity — NanoCrew provides this, users do NOT bring their own ────────
# Gemini Live is the voice engine (native speech-to-speech: ~1.4s to first audio
# vs ~4s for the STT->LLM->TTS pipeline). One key serves every tenant; what a
# tenant controls is how the agent SOUNDS and what it says, not who pays.
GEMINI_API_KEY=your_gemini_key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Install-wide DEFAULTS, used only for a tenant that has not chosen. Per-tenant
# values live on the `agent` row (agent.voice, agent.language) and override these.
GEMINI_LIVE_VOICE=Puck
GEMINI_LIVE_LANGUAGE=hi-IN

# Deliberately empty: a mid-call model swap changes the voice and manner, which
# makes a real call impossible to judge. Comma-separated list to re-enable.
GEMINI_LIVE_FALLBACKS=

# ── Telephony — API hostname only ────────────────────────────────────────────
# Credentials are per tenant (tenant.exotel_*). This is a region constant, not an
# identity, so it is the one Exotel value that stays here.
EXOTEL_SUBDOMAIN=api.exotel.com

# ── Service ──────────────────────────────────────────────────────────────────
PORT=8000
# VOICE_DB=/data/voice_agent.db

# ─── NanoCrew — environment variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Lines starting with # are comments. All values are strings unless noted.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# At least one is required. If LITELLM_PROXY_URL is set, these are forwarded
# to the proxy; otherwise the orchestrator and agents use them directly.

ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MOONSHOT_KIMI_API_KEY=
OPENROUTER_API_KEY=


# ── LiteLLM Proxy (optional but recommended) ──────────────────────────────────
# When set, all LLM calls route through the proxy for unified rate-limiting,
# fallback, and cost tracking. Set in docker-compose.yml or here.

LITELLM_PROXY_URL=http://litellm:4000
LITELLM_PROXY_KEY=sk-nanocrew-proxy


# ── Model Selection ───────────────────────────────────────────────────────────
# Comma-separated priority list of model IDs for the agent runtime.
# First model in the list is used by default; the proxy falls back down the list
# on 429 / quota errors.
# Example: claude-sonnet-4-6,deepseek/deepseek-chat,gemini/gemini-2.5-pro

MODEL_PRIORITY=claude-sonnet-4-6

# Override model for specific tiers (optional — falls back to MODEL_PRIORITY):
# NANOBOT_MODEL=          # default agent model
# NANOBOT_MODEL_PREMIUM=  # used for complex/long tasks
# NANOBOT_MODEL_MINI=     # used for fast/cheap subtasks
# LIGHT_MODEL=            # orchestrator-side lightweight calls
# VISION_MODEL=           # image-understanding calls (defaults to NANOBOT_MODEL)

# Disable DeepSeek extended-thinking output (set true if responses include
# <think> blocks you don't want shown to users):
DEEPSEEK_DISABLE_THINKING=false


# ── Agent Runtime ─────────────────────────────────────────────────────────────
# Docker image used for agent containers. Build with: ./container/build.sh
CONTAINER_IMAGE=nanocrew-agent:latest

# An agent cycle has no wall-clock limit — it may work for hours or days. It is ended when it
# goes silent (no output at all) for CYCLE_IDLE_TIMEOUT_MS, default 30m; working agents write a
# line every step and a heartbeat during long tool calls (src/agents/liveness.ts). Spend is
# bounded by the daily budget, checked after every model call (src/agents/live-spend.ts).
# CYCLE_MAX_MS is an optional hard ceiling; 0 (the default) means none.
CYCLE_IDLE_TIMEOUT_MS=1800000
CYCLE_MAX_MS=0

# Timeout for the legacy group-chat container runner only (src/container-runner.ts). It no
# longer limits agent cycles.
CONTAINER_TIMEOUT=1800000

# How long (ms) to keep a warm daemon container alive after its last cycle. Default 30m.
IDLE_TIMEOUT=1800000

# How long (ms) a job container may run. Default 6h.
JOB_CONTAINER_TIMEOUT=21600000

# Maximum number of agent containers running concurrently.
MAX_CONCURRENT_CONTAINERS=5

# Maximum number of job containers running concurrently.
MAX_CONCURRENT_JOBS=3

# Maximum output bytes captured from a single container run. Default 10 MB.
CONTAINER_MAX_OUTPUT_SIZE=10485760

# Warm-daemon pool: keep idle agent containers warm so cycles start instantly.
# Set NANOBOT_PERSISTENT=off to disable (one-shot containers instead).
NANOBOT_PERSISTENT=on
NANOBOT_DAEMON_MAX=4
NANOBOT_DAEMON_IDLE_TTL_MS=600000

# Worker pool: parallel workers for background job processing.
WORKER_POOL_SIZE=1
WORKER_MAX_TASKS=15

# Per-container resource limits (Docker --memory / --cpus flags).
DEFAULT_MEMORY_LIMIT_MAIN=2g
DEFAULT_MEMORY_LIMIT_WORKER=1g
DEFAULT_CPU_LIMIT_MAIN=2
DEFAULT_CPU_LIMIT_WORKER=1


# ── Behavioural Toggles ───────────────────────────────────────────────────────
# These are forwarded into each agent container as env vars.

# Verification loop: agent re-checks its own output before replying (on/off).
VERIFY_LOOP=on

# Plan-first nudge: agent is prompted to outline a plan before executing (on/off).
PLAN_FIRST_ENFORCE=on

# Lean exploration: agent is nudged toward focused search over broad sweeps (on/off).
LEAN_EXPLORE=on

# Self-extension: agent may extend its own reasoning mid-cycle (on/off).
SELF_EXTEND=on

# Deferred tools: advertise a lean core toolset and load the rest on demand (on/off).
# Reduces prompt size ~40%. Set off to send all tools upfront.
DEFERRED_TOOLS=on

# Persistent session: one continuous agent session per agent instead of
# stateless per-message cycles. Set off to revert to stateless mode.
PERSISTENT_SESSION=on


# ── Assistant Identity ────────────────────────────────────────────────────────
# Name of the default assistant agent (used in channel trigger matching).
ASSISTANT_NAME=Nano

# Set true if the assistant WhatsApp account has its own dedicated phone number
# (not linked as a companion device to another number).
ASSISTANT_HAS_OWN_NUMBER=false


# ── Channels ──────────────────────────────────────────────────────────────────
# Enable WhatsApp channel (requires scanning QR or pairing a device on first run).
WHATSAPP_ENABLED=false


# ── Dashboard & API ───────────────────────────────────────────────────────────
# Port the orchestrator API and React dashboard are served on.
DASHBOARD_PORT=3002

# Log level for the orchestrator process (trace | debug | info | warn | error).
LOG_LEVEL=info


# ── Security ──────────────────────────────────────────────────────────────────
# Secret key for encrypting computer-use session tokens. Must be changed in prod.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=change-me-generate-with-crypto-randomBytes-32

# Daily spend cap in USD across all agents. Leave blank to disable.
GLOBAL_DAILY_BUDGET_USD=


# ── Authentication (Stage 28 / Topic 03) ──────────────────────────────────────
# Bootstrap admin account. On first boot the admin user is created from these and
# all existing (pre-auth) data is assigned to it. Required for auth to work.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-me-strong-password

# Signs login session cookies. Keep it stable in prod (changing it logs everyone out).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-with-crypto-randomBytes-32

# Public base URL of the app — used to build password-reset / welcome links.
APP_URL=http://localhost:5173

# true = anyone can self-serve at /signup; false = invite-only (admin creates accounts).
SIGNUP_OPEN=false

# Password-reset / welcome emails (Resend — https://resend.com). Optional until Phase 8.
RESEND_API_KEY=


# ── Monitoring (Stage 28 / Topic 10) ──────────────────────────────────────────
# Sentry error tracking. Leave blank to disable (no-op). Get a DSN at sentry.io →
# create a Node project → copy the DSN.
SENTRY_DSN=


# ── Integrations (optional) ───────────────────────────────────────────────────
# Brave Search API key — used by the agent web search tool.
BRAVE_API_KEY=

# Firecrawl API key — optional. web_search/web_fetch already reach Firecrawl without one,
# but keyless access is rate-limited per IP per day and every agent container egresses
# through this host, so they all share that one budget. A free key (firecrawl.dev, 1000
# credits/month, no card) gives this deployment its own. Leave blank to stay keyless.
FIRECRAWL_API_KEY=

# Residential proxy (DataImpulse). In PROD these are NOT read from this file — agents get
# them from the encrypted secrets store at owner scope, because the orchestrator does not
# pass .env through to cycle containers (see docs/deployment.md, "Agent secrets"). Set
# them here for LOCAL runs, so a local effector behaves like a prod one.
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Which HTTP tools may spend the residential proxy. Empty (the default) means the browser
# (effector) only. A comma list of tool names, or "all", opens it to those tools too.
PROXY_FOR_HTTP_TOOLS=

# TinyFish API key — leads web_search and powers batched web_fetch (up to 10 URLs in one
# request). Search and Fetch are free at any wallet balance including $0, but there is no
# keyless mode: without this the agent drops to DuckDuckGo and fetches one URL at a time,
# and loses the publication dates TinyFish returns. Free key at agent.tinyfish.ai/api-keys.
TINYFISH_API_KEY=

# Base URL for OAuth redirect callbacks (credentials flow).
# Example: https://nanocrew.example.com
OAUTH_REDIRECT_BASE=

# Base URL for inbound webhooks registered by agents.
# Example: https://nanocrew.example.com
WEBHOOK_BASE_URL=


# ── Docker-in-Docker (required for docker compose) ───────────────────────────
# The orchestrator spawns sibling agent containers through the Docker socket, so it needs the
# HOST path of this checkout. Absolute path, forward slashes.
# Example: /home/you/nanocrew   or   C:/Users/you/nanocrew
HOST_PROJECT_ROOT=

# Plan limits are a hosted-service feature; leave false for self-hosting.
ENFORCE_PLANS=false


# ── More optional settings ────────────────────────────────────────────────────
# Everything below is optional. Leave blank to keep the default.

# Timezone for schedules and logs (default UTC). Uncomment to change.
# TZ=

# Sign in with Google (blank = email + password only). Create an OAuth client at
# console.cloud.google.com; the redirect URI is APP_URL + /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email over SMTP, for password resets and welcome mail (for example Gmail with an app password).
# Blank = no email is sent.
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Telegram bot for owner notifications (blank = off). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=

# Spend guard-rails. How much budget (USD) an agent may give itself per day / month. Defaults: 20 / 200.
# Keep these commented out unless you set a number: an empty value is read as 0, not as "use the default".
# AGENT_SELF_MAX_DAILY_BUDGET=
# AGENT_SELF_MAX_MONTHLY_BUDGET=

# Swarm runs: worker containers alive at once, in total and per user. Default 8 / 8 (same rule: set a number or leave commented).
# SWARM_GLOBAL_WORKERS=
# SWARM_PER_OWNER_WORKERS=

# Email-address checker used by swarm verification (a Reacher service, github.com/reacherhq/check-if-email-exists).
# Not included in docker-compose; without it those checks report "unknown".
REACHER_URL=
